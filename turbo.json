{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"outputs": ["dist/**"],
			"dependsOn": ["typecheck"]
		},
		"//#lint": {},
		"//#lint:ci": {},
		"gen:prisma": {
			"outputs": ["prisma/generated/**", "prisma-2/generated/**"],
			"inputs": ["prisma/schema/**", "prisma-2/schema/**"],
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build", "gen:prisma"]
		},
		"clean": {},
		"typecheck": {
			"dependsOn": ["gen:prisma"]
		}
	}
}
